{
  "name": "stegocrypt-pwa",
  "version": "3.1.0",
  "description": "Client-side image steganography, memory-hard cryptography, and forensics workbench in Vite + TypeScript",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "steganography",
    "cryptography",
    "pwa",
    "typescript",
    "vite",
    "argon2id",
    "aes-256-gcm",
    "lsb-matching",
    "forensics"
  ],
  "author": "VelliDR",
  "license": "MIT",
  "dependencies": {
    "@noble/ciphers": "^1.2.1",
    "@noble/hashes": "^1.7.1",
    "hash-wasm": "^4.12.0",
    "jsqr": "^1.4.0",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/qrcode-generator": "^0.0.16",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
